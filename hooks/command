#!/usr/bin/env bash

# The agent sources a shell hook into its wrapper and, when the hook exits 0,
# carries what it leaves into the rest of the job: the exported environment,
# and the working directory the later hooks and the artifact upload start in
# (agent v3.138.0's internal/job/executor.go, read 2026-10-08). This hook
# changes both as it runs: it puts a bootstrapped Node first on PATH, which
# is removed when it ends, it moves into working-directory, and it takes
# FJALL_API_KEY out of the environment. Sourced, it runs itself as a child of
# the wrapper instead, so none of that outlives it; a BASH_ENV the job sets
# is read twice for this hook, once by the wrapper and once by the child.
if [ "${BASH_SOURCE[0]}" != "$0" ]; then
  "${BASH}" "${BASH_SOURCE[0]}"
  return
fi
set -euo pipefail

# The deploy token is handed to one process the hook runs, the CLI, and to
# nothing before it: not a property check, the Node bootstrap, npm or the
# engine resolver. So it leaves the environment before anything runs, and is
# held in FJALL_API_KEY, unexported, under no second name a job may export
# too: a job's own DEPLOY_TOKEN, for one, reaches the CLI as the job set it.
# An allexport the shell inherited (from BASH_ENV, say) would export a
# fetched token again when it is set, and an inherited xtrace would print it
# into the job log, so both are turned off first; the braces keep the trace
# of turning xtrace off out of the log as well. This shell is the hook's own
# child of the agent's wrapper (the re-exec just above), so none of this
# reaches a hook after it: those see an environment-supplied token as the
# hooks before this one did, and never a fetched one.
set +a
{ set +x; } 2>/dev/null
export -n FJALL_API_KEY

# The CLI major this plugin release is built against (design § 5.2 version tie).
# `cli-version` defaults to it, so a pinned plugin ref floats across this major's
# minors/patches but never silently crosses into the next. Kept in lockstep with
# both manifests' `cli-version` default and CI_RUN_INPUT_VOCABULARY's
# COMPATIBLE_CLI_MAJOR by the ci-plugin parity test.
fjall_cli_default_major="39"

# The `fjall` wrapper's declared `engines.node`. When the agent's node is below
# this floor (or absent), the hook bootstraps node_version from nodejs.org.
# The floor is a full version, not a major: 22.3.0 is a Node 22 the published
# package refuses. Kept in lockstep with wrappers/fjall/package.json's
# `engines.node` by the ci-plugin parity test.
node_floor="22.12.0"

# The Node build the hook installs when it bootstraps, verified against a
# pinned SHA-256 before use — a tampered or truncated tarball aborts the run
# rather than executing. To bump it, change the version and run
# `npm run pin:node` in the fjall repository: it stamps both per-arch digests
# from https://nodejs.org/dist/v<version>/SHASUMS256.txt, and its test holds
# them to the pins it writes beside the plugin.
node_version="24.22.1"
node_sha256_x64="6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6"
node_sha256_arm64="dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e"

# Read plugin configuration. Every variable the hook sets for itself has a
# lower-case name, where a job's own are upper-case by convention, so each
# upper-case variable the job exports reaches the CLI, and with it the job's
# infrastructure.ts and image builds, as the job set it. What the hook does
# change for the CLI it changes on purpose: PATH on the Node bootstrap path,
# FJALL_API_KEY when it fetches the token, and the directory the CLI runs in.
cmd="${BUILDKITE_PLUGIN_FJALL_DEPLOY_COMMAND:-deploy}"
target="${BUILDKITE_PLUGIN_FJALL_DEPLOY_TARGET:-}"
service="${BUILDKITE_PLUGIN_FJALL_DEPLOY_SERVICE:-}"
mode="${BUILDKITE_PLUGIN_FJALL_DEPLOY_MODE:-full}"
environment="${BUILDKITE_PLUGIN_FJALL_DEPLOY_ENVIRONMENT:-}"
deploy_target="${BUILDKITE_PLUGIN_FJALL_DEPLOY_DEPLOY_TARGET:-}"
verbose="${BUILDKITE_PLUGIN_FJALL_DEPLOY_VERBOSE-false}"
skip_build="${BUILDKITE_PLUGIN_FJALL_DEPLOY_SKIP_BUILD-false}"
no_cascade="${BUILDKITE_PLUGIN_FJALL_DEPLOY_NO_CASCADE-false}"
region="${BUILDKITE_PLUGIN_FJALL_DEPLOY_REGION:-}"
image_tag="${BUILDKITE_PLUGIN_FJALL_DEPLOY_IMAGE_TAG:-}"
plan="${BUILDKITE_PLUGIN_FJALL_DEPLOY_PLAN-false}"
require_approval="${BUILDKITE_PLUGIN_FJALL_DEPLOY_REQUIRE_APPROVAL-false}"
auto_approve="${BUILDKITE_PLUGIN_FJALL_DEPLOY_AUTO_APPROVE-false}"
approval_token="${BUILDKITE_PLUGIN_FJALL_DEPLOY_APPROVAL_TOKEN:-}"
cli_version="${BUILDKITE_PLUGIN_FJALL_DEPLOY_CLI_VERSION:-${fjall_cli_default_major}}"
working_dir="${BUILDKITE_PLUGIN_FJALL_DEPLOY_WORKING_DIRECTORY:-.}"
force="${BUILDKITE_PLUGIN_FJALL_DEPLOY_FORCE-false}"
build_record="${BUILDKITE_PLUGIN_FJALL_DEPLOY_BUILD_RECORD-true}"

# Every property is checked here, before anything is fetched, installed or
# run. A refusal names the property and the rule, never the value: nothing has
# shown what a refused value holds, and the step log keeps it. Keep in
# lockstep with the GitHub Action's action.yml.
refuse() {
  echo "^^^ +++"
  echo "Error: $1"
  exit 1
}
not_repeated="The value given is not repeated here."

# A boolean property is exactly `true` or `false`, which is what the agent
# hands a hook for any YAML boolean, `True` and `TRUE` included (read in agent
# v3.138.0's source, 2026-10-08), and the only kind plugin.yml declares. A
# property left out sets no variable, and takes its default above. Anything
# else is what the pipeline wrote: a string someone quoted (`"yes"`,
# `"True"`), an unquoted number (`1`), a `yes` or `on` the agent's YAML 1.2
# parser keeps as a string, or an interpolation that came out empty
# (`"${PLAN_ONLY}"` with the variable unset). The reads below would take any
# of them as false, which for plan, require-approval and no-cascade is the
# arm that changes more.
require_boolean() {
  case "$2" in
    true | false) ;;
    "") refuse "'$1' is empty: give true or false, or leave it out to take its default." ;;
    *) refuse "'$1' must be true or false. ${not_repeated}" ;;
  esac
}
require_boolean verbose "${verbose}"
require_boolean skip-build "${skip_build}"
require_boolean no-cascade "${no_cascade}"
require_boolean plan "${plan}"
require_boolean require-approval "${require_approval}"
require_boolean auto-approve "${auto_approve}"
require_boolean force "${force}"
require_boolean build-record "${build_record}"

# A string property the pipeline wrote but left empty is refused too, and
# for the same cause: the agent sets no variable for a property left out,
# so an empty one is what the pipeline wrote, most often an interpolation
# whose variable was unset. Each read takes it as the property left out,
# so an empty image-tag would build and deploy rather than roll back. An
# empty target is refused as a missing one, and an empty list or list item
# by the list check.
require_value() {
  local var
  var="BUILDKITE_PLUGIN_FJALL_DEPLOY_$(printf '%s' "$1" | tr 'a-z-' 'A-Z_')"
  if [ -n "${!var+set}" ] && [ -z "${!var}" ]; then
    refuse "'$1' is empty: give it a value, or leave it out."
  fi
}
require_value command
require_value service
require_value mode
require_value environment
require_value deploy-target
require_value region
require_value image-tag
require_value approval-token
require_value cli-version
require_value working-directory

# `-` is the spelling of "none" for a property with no value of its own, as
# in the GitHub Action, whose inputs default to it: a pipeline that may have
# no value writes `image-tag: "${ROLLBACK_TAG:--}"`, and the property reads
# as left out. None of these properties takes a value beginning with `-`.
# A list property's single `-` is read by the list check. Keep in lockstep
# with the GitHub Action's action.yml.
for name in service environment deploy_target region image_tag approval_token; do
  if [ "${!name}" = "-" ]; then
    printf -v "${name}" '%s' ""
  fi
done

# `-` means none only for a property with no value of its own. Of the rest,
# cli-version would hand it to npm as a version and working-directory to cd,
# which reads it as the previous directory, so both refuse it, as the other
# property checks refuse it everywhere else.
reject_none_marker() {
  if [ "$2" = "-" ]; then
    refuse "'$1' cannot be '-', which means none only for a property without a default: leave it out to take its default."
  fi
}
reject_none_marker cli-version "${cli_version}"
reject_none_marker working-directory "${working_dir}"

# Reject flag-shaped property values before they reach fjall. Property values
# are interpolated from pipeline YAML; a value beginning with '-' would be
# parsed by commander as a flag rather than a value, even though each is passed
# as a quoted argv element.
reject_leading_dash() {
  case "$2" in
    -*) refuse "'$1' must not begin with '-'. ${not_repeated}" ;;
  esac
}
reject_leading_dash command "${cmd}"
reject_leading_dash target "${target}"
reject_leading_dash service "${service}"
reject_leading_dash mode "${mode}"
reject_leading_dash environment "${environment}"
reject_leading_dash deploy-target "${deploy_target}"
reject_leading_dash region "${region}"
reject_leading_dash image-tag "${image_tag}"
reject_leading_dash approval-token "${approval_token}"

# A list property arrives as indexed variables (_0, _1, ...), each item
# guarded like the scalars. A single value arrives under the bare name, a map
# or a list of maps under non-numeric suffixes, and an empty item would end
# the composition loops below early: each would drop items without a word, so
# each is refused, but for a single `-`, which reads as the property left
# out. The prefix's names are passed in, expanded at the call.
check_list_property() {
  local property="$1" prefix="$2" i=0 var
  shift 2
  if [ -n "${!prefix+set}" ]; then
    if [ "${!prefix}" = "-" ]; then
      return
    fi
    if [ -z "${!prefix}" ]; then
      refuse "'${property}' is empty: give it a list of strings, or leave it out."
    fi
    refuse "'${property}' must be a list of strings, not a single value. ${not_repeated}"
  fi
  while var="${prefix}_${i}" && [ -n "${!var+set}" ]; do
    if [ -z "${!var}" ]; then
      refuse "'${property}' item $((i + 1)) is empty."
    fi
    reject_leading_dash "${property}" "${!var}"
    i=$((i + 1))
  done
  if [ "$#" -ne "${i}" ]; then
    refuse "'${property}' must be a list of strings. ${not_repeated}"
  fi
}
# shellcheck disable=SC2086 # variable names, which cannot split or glob
check_list_property build-args BUILDKITE_PLUGIN_FJALL_DEPLOY_BUILD_ARGS ${!BUILDKITE_PLUGIN_FJALL_DEPLOY_BUILD_ARGS_@}
# shellcheck disable=SC2086 # variable names, which cannot split or glob
check_list_property build-secrets BUILDKITE_PLUGIN_FJALL_DEPLOY_BUILD_SECRETS ${!BUILDKITE_PLUGIN_FJALL_DEPLOY_BUILD_SECRETS_@}

if [ -z "${target}" ]; then
  echo "^^^ +++"
  echo "Error: 'target' is required"
  exit 1
fi

# `supersede` is an object, so the agent sets only its leaves, _AFTER,
# _TOKEN_SECRET and _BARRIERS_<n>. A single value arrives under the bare name,
# where `-` reads as the property left out, as it does for every property
# with no value of its own. Any other name under the prefix is a misspelt key
# or a wrong shape, refused here rather than ignored, since a barrier the hook
# never read is a barrier a skip would step over.
supersede="false"
supersede_after="${BUILDKITE_PLUGIN_FJALL_DEPLOY_SUPERSEDE_AFTER-}"
supersede_token_secret="${BUILDKITE_PLUGIN_FJALL_DEPLOY_SUPERSEDE_TOKEN_SECRET-}"
supersede_barriers=()
supersede_barrier_count=0
for supersede_var in ${!BUILDKITE_PLUGIN_FJALL_DEPLOY_SUPERSEDE@}; do
  case "${supersede_var#BUILDKITE_PLUGIN_FJALL_DEPLOY_SUPERSEDE}" in
    "")
      case "${!supersede_var}" in
        -) ;;
        "") refuse "'supersede' is empty: give it an object with 'after' and 'token-secret', or leave it out." ;;
        *) refuse "'supersede' must be an object with 'after' and 'token-secret', not a single value. ${not_repeated}" ;;
      esac
      ;;
    _AFTER | _TOKEN_SECRET) supersede="true" ;;
    _BARRIERS)
      supersede="true"
      case "${!supersede_var}" in
        -) ;;
        "") refuse "'supersede.barriers' is empty: give it a list of strings, or leave it out." ;;
        *) refuse "'supersede.barriers' must be a list of strings, not a single value. ${not_repeated}" ;;
      esac
      ;;
    *)
      if ! [[ "${supersede_var}" =~ ^BUILDKITE_PLUGIN_FJALL_DEPLOY_SUPERSEDE_BARRIERS_(0|[1-9][0-9]*)$ ]]; then
        refuse "'supersede' sets ${supersede_var}, which is not after, token-secret or a barriers list item."
      fi
      supersede="true"
      supersede_barrier_count=$((supersede_barrier_count + 1))
      ;;
  esac
done

# A leaf left out is required, and an empty one is refused as the empty
# properties above are.
require_supersede_leaf() {
  local var
  var="BUILDKITE_PLUGIN_FJALL_DEPLOY_SUPERSEDE_$(printf '%s' "$1" | tr 'a-z-' 'A-Z_')"
  if [ -z "${!var+set}" ]; then
    refuse "'supersede.$1' is required. $2"
  fi
  if [ -z "${!var}" ]; then
    refuse "'supersede.$1' is empty: give it a value. $2"
  fi
}

if [ "${supersede}" = "true" ]; then
  case "${cmd}" in
    deploy) ;;
    destroy | build) refuse "'supersede' is valid only with command: deploy (got '${cmd}')." ;;
    *) refuse "'supersede' is valid only with command: deploy. ${not_repeated}" ;;
  esac
  require_supersede_leaf after "It names the step that must have passed on the newer build."
  require_supersede_leaf token-secret "It names the Buildkite secret that holds a read_builds token."
  reject_leading_dash supersede.after "${supersede_after}"
  reject_leading_dash supersede.token-secret "${supersede_token_secret}"
  i=0
  while [ "${i}" -lt "${supersede_barrier_count}" ]; do
    var="BUILDKITE_PLUGIN_FJALL_DEPLOY_SUPERSEDE_BARRIERS_${i}"
    if [ -z "${!var+set}" ]; then
      refuse "'supersede.barriers' has no item ${i}, so its items are not a list."
    fi
    value="${!var}"
    if [ -z "${value}" ]; then
      refuse "'supersede.barriers' item ${i} is empty."
    fi
    reject_leading_dash supersede.barriers "${value}"
    case "/${value}/" in
      //*) refuse "'supersede.barriers' item ${i} is an absolute path. Barriers are relative to the repository root." ;;
      */../*) refuse "'supersede.barriers' item ${i} has a '..' segment." ;;
    esac
    supersede_barriers+=("${value}")
    i=$((i + 1))
  done
fi

# Classify the target. The app-only `ci run <cmd> <target>` shim rejects the
# tier words (T3: tier deploys and destroys are noun-verb), so an
# organisation/platform/account target routes to `fjall <noun> <cmd>` while an
# app target keeps the ci run shim. Build arguments as an array — never a
# space-joined string. A bare `fjall ${args}` word-splits and glob-expands
# every input, so a target/service/environment value carrying spaces, `*`, or
# extra `--flags` would inject arguments into the CLI invocation. The
# quoted-array form `fjall "${args[@]}"` passes each value as exactly one argv
# element. Keep this branching in lockstep with the GitHub Action's action.yml.
case "${target}" in
  organisation) tier_noun="org" ;;
  platform) tier_noun="platform" ;;
  account) tier_noun="account" ;;
  *) tier_noun="" ;;
esac

# A run keeps the build record only when it builds images. A destroy and a
# tier target build none, so they keep none whatever `build-record` says,
# rather than refuse it. It is on by default, and the GitHub Action is handed
# a value the workflow set and its default alike. Keep in lockstep with the
# GitHub Action's action.yml.
keep_record="false"
if [ "${build_record}" = "true" ] && [ "${cmd}" != "destroy" ] && [ -z "${tier_noun}" ]; then
  keep_record="true"
fi

if [ -n "${tier_noun}" ]; then
  # Tier path. The tier leaves honour only --force, --verbose and
  # (organisation) --no-cascade — every app/deploy-only/approval-gate input is
  # rejected here rather than silently dropped, so a `plan: true` can never
  # become an unpreviewed tier mutation.
  if [ "${cmd}" != "deploy" ] && [ "${cmd}" != "destroy" ]; then
    echo "^^^ +++"
    echo "Error: tier target '${target}' supports the commands deploy and destroy only (build is application-only). The value given is not repeated here."
    exit 1
  fi

  incompatible=()
  if [ -n "${service}" ]; then incompatible+=("service"); fi
  if [ -n "${mode}" ] && [ "${mode}" != "full" ]; then incompatible+=("mode"); fi
  if [ -n "${environment}" ]; then incompatible+=("environment"); fi
  if [ -n "${deploy_target}" ]; then incompatible+=("deploy-target"); fi
  if [ "${skip_build}" = "true" ]; then incompatible+=("skip-build"); fi
  if [ -n "${region}" ]; then incompatible+=("region"); fi
  if [ -n "${image_tag}" ]; then incompatible+=("image-tag"); fi
  if [ "${plan}" = "true" ]; then incompatible+=("plan"); fi
  if [ "${require_approval}" = "true" ]; then incompatible+=("require-approval"); fi
  if [ "${auto_approve}" = "true" ]; then incompatible+=("auto-approve"); fi
  if [ -n "${approval_token}" ]; then incompatible+=("approval-token"); fi
  if [ -n "${BUILDKITE_PLUGIN_FJALL_DEPLOY_BUILD_ARGS_0:-}" ]; then incompatible+=("build-args"); fi
  if [ -n "${BUILDKITE_PLUGIN_FJALL_DEPLOY_BUILD_SECRETS_0:-}" ]; then incompatible+=("build-secrets"); fi
  if [ "${supersede}" = "true" ]; then incompatible+=("supersede"); fi
  if [ "${#incompatible[@]}" -gt 0 ]; then
    echo "^^^ +++"
    echo "Error: these properties are not valid with tier target '${target}': ${incompatible[*]}. Tier ${cmd}s accept only force, verbose, and no-cascade (organisation only)."
    exit 1
  fi

  if [ "${no_cascade}" = "true" ] && [ "${target}" != "organisation" ]; then
    echo "^^^ +++"
    echo "Error: no-cascade is only valid with target: organisation; the platform and account tiers have no cascade."
    exit 1
  fi

  args=("${tier_noun}" "${cmd}" --non-interactive)
  if [ "${force}" = "true" ]; then
    args+=(--force)
  fi
  if [ "${verbose}" = "true" ]; then
    args+=(--verbose)
  fi
  if [ "${no_cascade}" = "true" ]; then
    args+=(--no-cascade)
  fi
else
  # App path — thin shim onto `fjall ci run`; the CLI owns argv assembly and
  # command/flag validation (unknown commands, deploy-only flags on
  # destroy/build, mode vocabulary). --no-cascade is an organisation-tier
  # concept the ci run surface no longer accepts.
  if [ "${no_cascade}" = "true" ]; then
    echo "^^^ +++"
    echo "Error: no-cascade is only valid with target: organisation; application '${target}' has no cascade."
    exit 1
  fi

  args=(ci run "${cmd}" "${target}")

  if [ -n "${service}" ]; then
    args+=(--service "${service}")
  fi

  # Always non-interactive in CI
  args+=(--non-interactive)

  if [ -n "${mode}" ] && [ "${mode}" != "full" ]; then
    args+=(--mode "${mode}")
  fi

  if [ -n "${environment}" ]; then
    args+=(--environment "${environment}")
  fi

  if [ -n "${deploy_target}" ]; then
    args+=(--target "${deploy_target}")
  fi

  if [ "${skip_build}" = "true" ]; then
    args+=(--skip-build)
  fi

  if [ -n "${region}" ]; then
    args+=(--region "${region}")
  fi

  if [ -n "${image_tag}" ]; then
    args+=(--image-tag "${image_tag}")
  fi

  if [ "${plan}" = "true" ]; then
    args+=(--plan)
  fi

  if [ "${require_approval}" = "true" ]; then
    args+=(--require-approval)
  fi

  if [ "${auto_approve}" = "true" ]; then
    args+=(--auto-approve)
  fi

  if [ -n "${approval_token}" ]; then
    args+=(--approval-token "${approval_token}")
  fi

  # Buildkite array properties arrive as indexed env vars (_0, _1, ...)
  i=0
  while true; do
    var="BUILDKITE_PLUGIN_FJALL_DEPLOY_BUILD_ARGS_${i}"
    value="${!var:-}"
    if [ -z "${value}" ]; then
      break
    fi
    args+=(--build-arg "${value}")
    i=$((i + 1))
  done

  i=0
  while true; do
    var="BUILDKITE_PLUGIN_FJALL_DEPLOY_BUILD_SECRETS_${i}"
    value="${!var:-}"
    if [ -z "${value}" ]; then
      break
    fi
    args+=(--build-secret "${value}")
    i=$((i + 1))
  done

  if [ "${force}" = "true" ]; then
    args+=(--force)
  fi

  if [ "${verbose}" = "true" ]; then
    args+=(--verbose)
  fi
fi

# The deploy token comes from the environment when that supplies it, else
# from Buildkite's secret store (`buildkite-agent secret get` reads the
# pipeline's FJALL_API_KEY secret), fetched here, once every property is
# checked, so that a missing secret fails before any download. The CLI reads
# FJALL_API_KEY before stored credentials.
if [ -z "${FJALL_API_KEY:-}" ] && command -v buildkite-agent > /dev/null 2>&1; then
  echo "--- :key: Fetching FJALL_API_KEY from Buildkite secrets"
  FJALL_API_KEY="$(buildkite-agent secret get FJALL_API_KEY)"
fi

# Bootstrap Node when the agent's runtime is below the wrapper's floor (or
# absent). Fetch the pinned build, verify its SHA-256 before extracting, and
# prepend it to PATH so `npm`/`fjall` resolve to it. A digest mismatch aborts
# under `set -e` rather than executing an unverified binary.
node_agent_version="0.0.0"
if command -v node > /dev/null 2>&1; then
  node_agent_version="$(node --version 2>/dev/null || echo v0.0.0)"
  node_agent_version="${node_agent_version#v}"
fi
node_agent_version="${node_agent_version:-0.0.0}"
# Compare the FULL version, not the major: an agent on 22.3.0 passes a
# `-lt 22` test and still cannot run the CLI. `sort -V` orders versions and is
# present on GNU coreutils, macOS and busybox; the lower of the pair is the
# agent's exactly when the agent is below the floor. The first line is taken by
# expansion rather than `| head -n 1`: head exits on the first line, and the
# SIGPIPE that lands on sort fails the whole substitution under `pipefail`.
node_sorted="$(printf '%s\n%s\n' "${node_agent_version}" "${node_floor}" | sort -V)"
node_lowest="${node_sorted%%$'\n'*}"
if [ "${node_agent_version}" != "${node_floor}" ] && [ "${node_lowest}" = "${node_agent_version}" ]; then
  # The pinned builds are Linux tarballs, and `uname -m` spells arm64 the same
  # on macOS: without this, a macOS agent would put a Linux ELF first on PATH
  # and die at `npm install` with an exec-format error that names nothing.
  node_os="$(uname -s)"
  if [ "${node_os}" != "Linux" ]; then
    echo "^^^ +++"
    echo "Error: agent node ${node_agent_version} is below ${node_floor}, and the Node bootstrap installs Linux builds only (this agent runs ${node_os}); install Node >= ${node_floor} on the agent."
    exit 1
  fi
  echo "--- :node: Bootstrapping Node ${node_version} (agent node: ${node_agent_version}, floor: ${node_floor})"
  case "$(uname -m)" in
    x86_64 | amd64) node_arch="x64"; node_sha256="${node_sha256_x64}" ;;
    aarch64 | arm64) node_arch="arm64"; node_sha256="${node_sha256_arm64}" ;;
    *)
      echo "^^^ +++"
      echo "Error: unsupported architecture '$(uname -m)' for Node bootstrap; install Node >= ${node_floor} on the agent."
      exit 1
      ;;
  esac
  node_dist="node-v${node_version}-linux-${node_arch}"
  node_tarball="${node_dist}.tar.xz"
  node_tmp="$(mktemp -d)"
  # Reap the extracted tree on exit — including a set -e abort at the digest
  # gate — so a persistent self-hosted agent does not accumulate a Node tree per
  # build. Armed only once the dir exists, so the earlier exits never fire it.
  trap 'rm -rf "${node_tmp:-}"' EXIT
  # The download is bounded, as Fjall's own CI bounds the same one: a transfer
  # that stalls below 1 KB/s for a minute is cut and retried, with curl's
  # backoff, as is a transient failure; no attempt outlives --max-time, and
  # none starts past --retry-max-time. The limits are a customer agent's, whose
  # network may be slower than Fjall's, and stay well inside a deploy step's
  # timeout.
  curl -fsSL --connect-timeout 20 --speed-limit 1024 --speed-time 60 --max-time 600 --retry 2 --retry-max-time 300 \
    -o "${node_tmp}/${node_tarball}" "https://nodejs.org/dist/v${node_version}/${node_tarball}"
  if command -v sha256sum > /dev/null 2>&1; then
    echo "${node_sha256}  ${node_tmp}/${node_tarball}" | sha256sum -c -
  else
    echo "${node_sha256}  ${node_tmp}/${node_tarball}" | shasum -a 256 -c -
  fi
  tar -xJf "${node_tmp}/${node_tarball}" -C "${node_tmp}"
  export PATH="${node_tmp}/${node_dist}/bin:${PATH}"
  echo "Bootstrapped Node ${node_version}"
fi

# npm, the engine resolver, the version check, the supersede check and the
# build summary run without the job token, which could fetch the deploy token
# again, and without the AWS keys a step's environment may carry.
install_step() {
  (
    unset BUILDKITE_AGENT_ACCESS_TOKEN AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
    "$@"
  )
}

plugin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

# Skip this deploy when a newer deploy build already carries its commit, and
# hold it when its creator marked it and the deploy before it did not succeed.
# Both decisions are supersede-check.mjs's. Only its positive proof skips, and
# a marked build deploys only on its positive proof. Every other outcome holds
# a marked build and deploys an unmarked one. The module runs through
# install_step, so it never holds the deploy token, and it takes the read
# token on stdin, never argv or env.
#
# A held build deployed nothing and records neither `fjall-deploy:result` nor
# `fjall-deploy:started`, so the next marked build passes over it to the same
# red build. `$1` is the red build's number, or empty when the check could not
# judge the deploy before this one. `$2` is that build's result as the check
# names it.
hold_deploy() {
  local held_by="$1" held_result="${2-}" red_build outcome message
  if [ -n "${held_by}" ]; then
    buildkite-agent meta-data set "fjall-deploy:held-by" "${held_by}" || true
    red_build="#${held_by}"
    if [ -n "${BUILDKITE_BUILD_URL:-}" ]; then
      red_build="[#${held_by}](${BUILDKITE_BUILD_URL%/*}/${held_by})"
    fi
    if [ "${held_result}" = "unfinished" ]; then
      message="This build deployed nothing. Build ${red_build}, the deploy before it, started a deploy that has not ended, so this one would deploy over it. Wait for that deploy to end, then retry this one. To deploy over it anyway, Rebuild this build, which never holds."
    else
      outcome="did not succeed"
      if [ "${held_result}" = "unrecorded" ]; then
        outcome="started a deploy and ended before recording its result"
      fi
      message="This build deployed nothing. Build ${red_build}, the deploy before it, ${outcome}, so this one would deploy over it. Retry that build's deploy step until it passes, then retry this one. To deploy over it anyway, Rebuild this build, which never holds."
    fi
  else
    message="This build deployed nothing. The check could not prove that the deploy before it succeeded. Retry this step. To deploy anyway, Rebuild this build, which never holds."
  fi
  buildkite-agent annotate --style error --context fjall-deploy-held "${message}" || true
  echo "^^^ +++"
  exit 1
}

# A marked build that did not skip holds once a newer build has started or
# recorded a deploy, since its older commit would deploy over that one. The
# check stops before it judges the deploy below, so this records no
# `fjall-deploy:held-by`.
# `$1` is the newer build's number.
hold_overtaken() {
  local newer_build="#$1"
  if [ -n "${BUILDKITE_BUILD_URL:-}" ]; then
    newer_build="[#$1](${BUILDKITE_BUILD_URL%/*}/$1)"
  fi
  buildkite-agent annotate --style error --context fjall-deploy-held \
    "This build deployed nothing. Build ${newer_build}, which is newer, has started or recorded a deploy, so this build's older commit would deploy over it. To deploy this commit anyway, Rebuild this build, which never holds." || true
  echo "^^^ +++"
  exit 1
}

# One job of a build holds `supersede`, since the markers it writes are the
# build's, so a second job would write over the first one's result. A step
# with parallelism can run its jobs at once, which no claim can order, so it
# is refused. The claim is the build's id and the step's BUILDKITE_STEP_ID,
# which a retry keeps. A claim naming another build reads as unset, so a
# rebuild that carries its original's metadata is not refused. Two steps that
# start at the same moment can both read the claim unset, so this catches a
# second step that starts after the first, not one that runs beside it. The
# read drops BUILDKITE_METADATA_BUILD_ID, as the marker read below does.
claim_supersede_step() {
  local claim claimed
  if [ -n "${BUILDKITE_PARALLEL_JOB_COUNT:-}" ]; then
    echo "^^^ +++"
    echo "Error: this build deployed nothing. supersede is set on a step with parallelism, whose jobs would each write over the deploy result the others record. Set supersede on a deploy step with no parallelism."
    exit 1
  fi
  if [ -z "${BUILDKITE_BUILD_ID:-}" ] || [ -z "${BUILDKITE_STEP_ID:-}" ]; then
    echo "^^^ +++"
    echo "Error: this build deployed nothing. The job has no BUILDKITE_BUILD_ID or BUILDKITE_STEP_ID, so it cannot record itself as the step holding supersede."
    exit 1
  fi
  claim="${BUILDKITE_BUILD_ID}/${BUILDKITE_STEP_ID}"
  if ! claimed="$(env -u BUILDKITE_METADATA_BUILD_ID buildkite-agent meta-data get "fjall-deploy:supersede-step" --default "${claim}")"; then
    echo "^^^ +++"
    echo "Error: this build deployed nothing. The step holding supersede, fjall-deploy:supersede-step, could not be read. Retry this step."
    exit 1
  fi
  if [ "${claimed}" != "${claim}" ] && [[ "${claimed}" == "${BUILDKITE_BUILD_ID}/"* ]]; then
    echo "^^^ +++"
    echo "Error: this build deployed nothing. Another step of this build already set supersede, and a second one would write over the deploy result the first one records. Set supersede on one deploy step per build."
    exit 1
  fi
  if ! buildkite-agent meta-data set "fjall-deploy:supersede-step" "${claim}"; then
    echo "^^^ +++"
    echo "Error: this build deployed nothing. The step holding supersede could not be recorded in fjall-deploy:supersede-step. Retry this step."
    exit 1
  fi
}

# This build's creator's marker as the check's first word, read through the
# job's own agent rather than the builds list, so a marked build holds even
# when the list cannot be read. A read that fails prints `unknown`, which
# holds on any doubt and leaves the build's own entry in the builds list to
# say whether it is marked, so a hand build still deploys once the list is
# read. The read drops BUILDKITE_METADATA_BUILD_ID, which `get` would
# otherwise take as a `--build` naming another build.
supersede_marker_word() {
  local marker
  if ! marker="$(env -u BUILDKITE_METADATA_BUILD_ID buildkite-agent meta-data get "fjall-deploy:supersedable" --default "false")"; then
    echo "unknown"
  elif [ "${marker}" = "true" ]; then
    echo "marked"
  else
    echo "unmarked"
  fi
}

if [ "${supersede}" = "true" ]; then
  echo "--- :fast_forward: Checking the deploys before and after this one"
  if command -v buildkite-agent > /dev/null 2>&1; then
    claim_supersede_step
  fi
  if [ -n "${BUILDKITE_REBUILT_FROM_BUILD_NUMBER:-}" ]; then
    echo "supersede: deploying, a rebuild never skips or holds"
  elif ! command -v buildkite-agent > /dev/null 2>&1; then
    echo "supersede: deploying, buildkite-agent is not on this agent's PATH"
  elif ! supersede_token="$(buildkite-agent secret get "${supersede_token_secret}")" || [ -z "${supersede_token}" ]; then
    supersede_marked="$(supersede_marker_word)"
    if [ "${supersede_marked}" = "marked" ]; then
      echo "supersede: holding, the supersede.token-secret secret could not be read"
      hold_deploy ""
    elif [ "${supersede_marked}" = "unknown" ]; then
      echo "supersede: holding, neither this build's fjall-deploy:supersedable marker nor the supersede.token-secret secret could be read"
      hold_deploy ""
    fi
    echo "supersede: deploying, the supersede.token-secret secret could not be read"
  else
    supersede_marked="$(supersede_marker_word)"
    if [ "${supersede_marked}" = "unknown" ]; then
      echo "supersede: this build's fjall-deploy:supersedable marker could not be read, so its entry in the builds list says whether it is marked"
    fi
    set +e
    supersede_line="$(printf '%s' "${supersede_token}" | install_step node "${plugin_dir}/supersede-check.mjs" "${supersede_marked}" "${supersede_after}" ${supersede_barriers[@]+"${supersede_barriers[@]}"})"
    supersede_status=$?
    set -e
    supersede_token=""
    echo "${supersede_line}"
    skip_line_pattern='^supersede: skipped for #([1-9][0-9]*) at ([0-9a-f]{40})$'
    held_line_pattern='^supersede: held by #([1-9][0-9]*), whose deploy result is ([a-z][a-z_-]{0,39}|[?])$'
    overtaken_line_pattern='^supersede: overtaken by #([1-9][0-9]*), which is newer and started or recorded a deploy$'
    if [ "${supersede_status}" -eq 10 ] && [[ "${supersede_line}" =~ ${skip_line_pattern} ]]; then
      newer_number="${BASH_REMATCH[1]}"
      newer_commit="${BASH_REMATCH[2]}"
      # The result is written first. A build that skipped with no
      # `superseded` on it would send its readers looking for a deploy of this
      # commit that never happens. A skip that cannot record it holds, since
      # only a marked build skips and its hold was never judged.
      # `meta-data set` writes to the build of `--job`, which defaults to
      # BUILDKITE_JOB_ID, a standard variable a build's env cannot override.
      # Unlike `get` it has no `--build`, so adding one would fail this write
      # and turn every skip into a hold.
      if buildkite-agent meta-data set "fjall-deploy:result" "superseded"; then
        buildkite-agent meta-data set "fjall-deploy:superseded-by" "${newer_number}" || true
        newer_build="#${newer_number}"
        if [ -n "${BUILDKITE_BUILD_URL:-}" ]; then
          newer_build="[#${newer_number}](${BUILDKITE_BUILD_URL%/*}/${newer_number})"
        fi
        own_commit="${BUILDKITE_COMMIT:-}"
        buildkite-agent annotate --style warning --context fjall-deploy-superseded \
          "This build deployed nothing. Build ${newer_build}, at \`${newer_commit:0:9}\`, is newer, has passed its \`${supersede_after}\` step and carries this build's commit \`${own_commit:0:9}\`, so its deploy covers this one." || true
        exit 0
      fi
      echo "supersede: holding, the result superseded could not be recorded, and the deploy before this one was never judged"
      hold_deploy ""
    elif [ "${supersede_status}" -eq 11 ] && [[ "${supersede_line}" =~ ${held_line_pattern} ]]; then
      hold_deploy "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    elif [ "${supersede_status}" -eq 11 ] && [[ "${supersede_line}" =~ ${overtaken_line_pattern} ]]; then
      hold_overtaken "${BASH_REMATCH[1]}"
    elif [ "${supersede_status}" -eq 11 ] && [[ "${supersede_line}" == "supersede: holding, "* ]]; then
      hold_deploy ""
    elif [ "${supersede_status}" -eq 0 ] && [[ "${supersede_line}" == "supersede: deploying, "* ]]; then
      :
    elif [ "${supersede_marked}" != "unmarked" ]; then
      echo "supersede: holding, the check exited ${supersede_status} with no verdict this hook reads"
      hold_deploy ""
    elif [ "${supersede_status}" -ne 0 ]; then
      echo "supersede: deploying, the check exited ${supersede_status}"
    fi
  fi
  # A retry that gets this far clears the hold annotation an earlier attempt
  # posted. Its fjall-deploy:held-by stays, since meta-data cannot be unset.
  if [ "${BUILDKITE_RETRY_COUNT:-0}" != "0" ]; then
    buildkite-agent annotation remove --context fjall-deploy-held > /dev/null 2>&1 || true
  fi
fi

# Install the CLI. No package's lifecycle script runs: the CLI's dependency
# tree is resolved afresh on every install, and an install script is the usual
# way a compromised release reads the environment it runs in. In the trees
# the latest releases of fjall majors 10, 15, 20, 25 and 29 to 39 resolve to
# (measured on macOS, 2026-10-08), the packages that declare one, esbuild
# (its binary-path optimisation) and fsevents (macOS only, prebuilt), work
# without it, provided npm installs optional dependencies, as it does by
# default: esbuild's binary is one.
echo "--- :package: Installing fjall"
if [ "${cli_version}" = "latest" ]; then
  install_step npm install -g --ignore-scripts fjall
elif [ "${cli_version}" = "auto" ]; then
  # Match the engine major to the app's pinned @fjall/components-infrastructure
  # so the deploy engine never skews across a major from the constructs it
  # synthesises (engine-version contract). The resolver ships alongside this
  # hook; working_dir reaches it via argv, never interpolated into the shell.
  # Kept byte-identical to the GitHub Action's resolver (parity test locks it).
  if ! resolved_engine_spec="$(install_step node "${plugin_dir}/resolve-fjall-engine.mjs" "${working_dir}")"; then
    echo "Failed to resolve the fjall engine from the app's @fjall/components-infrastructure pin" >&2
    exit 1
  fi
  # An exit status is not an answer. The resolver prints one line and exits 0;
  # a status-only check reads a silent success as a spec and hands the empty
  # string to npm, which installs something nobody chose on the lane whose
  # whole purpose is to pick the right major. Emptiness is its own refusal.
  if [ -z "${resolved_engine_spec}" ]; then
    echo "The fjall engine resolver exited 0 without naming an engine — refusing to install an unnamed one" >&2
    exit 1
  fi
  install_step npm install -g --ignore-scripts "${resolved_engine_spec}"
else
  install_step npm install -g --ignore-scripts "fjall@${cli_version}"
fi
echo "Installed $(install_step fjall --version)"

# Run with timing; tee output so the approval token can be captured
echo "--- :rocket: fjall ${args[*]}"
# The build summary keeps a build only when its context lies inside the
# checkout, so it reads the builder from the job's own directory, which
# `working-directory` moves the CLI away from.
checkout_root="$(pwd)"
cd -- "${working_dir}"

# The one process the deploy token is handed to. Without one, the CLI falls
# back to its stored credentials.
run_cli() {
  if [ -n "${FJALL_API_KEY:-}" ]; then
    FJALL_API_KEY="${FJALL_API_KEY}" fjall "$@"
  else
    fjall "$@"
  fi
}

# Once the run has ended and its result is recorded, build-summary.mjs reads
# the images it built from the `fjall` builder's history, never from the CLI,
# and writes one table, a row per image, which goes up as an info annotation.
# When the run keeps the build record, it also writes the builder's record of
# those images, which goes up as an artifact. Nothing here changes the step's
# exit status. The body is a subshell, because under `set -u` an unbound
# variable ends the shell even inside an `|| true` list, and here it ends only
# the subshell. Every agent call ends `|| true`, and the subshell's own trap
# removes its temporary directory however it ends. The module runs through
# install_step, so it holds neither token nor the step's AWS keys.
report_build_summary() (
  if [ "${cmd}" = "destroy" ]; then
    echo "No build summary, since a destroy builds no image."
    return 0
  fi
  if ! command -v docker > /dev/null 2>&1; then
    echo "No build summary, since docker is not on this agent's PATH."
    return 0
  fi
  if ! summary_dir="$(mktemp -d)" || [ -z "${summary_dir}" ]; then
    echo "No build summary, since its temporary directory could not be made."
    return 0
  fi
  trap 'rm -rf -- "${summary_dir}"' EXIT
  summary_file="${summary_dir}/summary.md"
  outputs_file="${summary_dir}/outputs"
  record_dir="${summary_dir}/record"
  : > "${summary_file}"
  : > "${outputs_file}"
  summary_args=(--ci buildkite --since "${start}" --checkout "${checkout_root}" --summary-out "${summary_file}" --outputs "${outputs_file}")
  if [ "${keep_record}" = "true" ]; then
    if mkdir -- "${record_dir}"; then
      summary_args+=(--record-dir "${record_dir}")
    else
      echo "No build record, since its temporary directory could not be made."
    fi
  fi

  summary_status=0
  install_step node "${plugin_dir}/build-summary.mjs" "${summary_args[@]}" || summary_status=$?
  if [ "${summary_status}" -ne 0 ]; then
    echo "The build summary module exited ${summary_status}, so the summary may be incomplete."
  fi

  if ! command -v buildkite-agent > /dev/null 2>&1; then
    echo "The build summary is not annotated, since buildkite-agent is not on this agent's PATH."
    return 0
  fi
  # Keyed by job, since Buildkite documents no variable that tells the jobs of
  # a matrix step apart, and a retry is a new job whose summary sits beside
  # the earlier attempt's.
  if [ -s "${summary_file}" ]; then
    if [ -n "${BUILDKITE_JOB_ID:-}" ]; then
      buildkite-agent annotate --style info --context "fjall-build-summary-${BUILDKITE_JOB_ID}" < "${summary_file}" || true
    else
      echo "The build summary is not annotated, since the job has no BUILDKITE_JOB_ID to name its annotation by."
    fi
  fi

  # The module names the record it wrote. Only that name's one shape is
  # uploaded, from the record directory, so the name can neither reach outside
  # it nor pick another file.
  if [ "${keep_record}" = "true" ]; then
    record_name=""
    while read -r line || [ -n "${line}" ]; do
      case "${line}" in
        record-name=*) record_name="${line#record-name=}" ;;
      esac
    done < "${outputs_file}"
    if [ -z "${record_name}" ]; then
      return 0
    fi
    record_name_pattern='^fjall-build-record-[0-9a-f]{8}\.dockerbuild$'
    if ! [[ "${record_name}" =~ ${record_name_pattern} ]]; then
      echo "The build record is not uploaded, since its name is not one build-summary.mjs writes. ${not_repeated}"
    elif [ ! -f "${record_dir}/${record_name}" ]; then
      echo "The build record is not uploaded, since build-summary.mjs named a record it did not write."
    else
      echo "Uploading the build record ${record_name} as an artifact. It holds build arg values, each Dockerfile's source and each step's log, unmasked, and anyone who can read this build can download it."
      (cd -- "${record_dir}" && buildkite-agent artifact upload "${record_name}") || true
    fi
  fi
)

# With `supersede` set, the next marked build's hold reads this marker, the
# job that started the deploy, against `fjall-deploy:result-job`, the job that
# recorded the result. A retry is a new job, so a deploy whose result write is
# lost, or whose job a timeout, a lost agent or a cancel ends first, then holds
# that build instead of counting as no deploy or as an earlier attempt's
# result. A deploy that cannot record the marker would count as none, so it
# does not start. It is the last write before the CLI, so a step that fails
# before it, as an install can, deployed nothing and reads that way.
record_attempt="false"
if [ "${supersede}" = "true" ] && command -v buildkite-agent > /dev/null 2>&1; then
  record_attempt="true"
  if [ -z "${BUILDKITE_JOB_ID:-}" ] || ! buildkite-agent meta-data set "fjall-deploy:started" "${BUILDKITE_JOB_ID}"; then
    echo "^^^ +++"
    echo "Error: this build deployed nothing. The fjall-deploy:started marker could not be recorded, and without it the next build would read a deploy that ends before recording its result as no deploy. Retry this step."
    exit 1
  fi
fi

log_file="$(mktemp)"
start=$(date +%s)

set +e
run_cli "${args[@]}" 2>&1 | tee "${log_file}"
exit_code=${PIPESTATUS[0]}
set -e

end=$(date +%s)
duration=$((end - start))

# The CLI prints "Approval token: <token>" when a plan has pending changes
token_line=$(grep -m1 '^Approval token: ' "${log_file}" || true)
rm -f "${log_file}"

# Exit 2 = the run stopped without failing: a plan with changes pending
# approval, a plan refused at the approval gate, or a run cancelled before it
# completed, which can stop after applying part of its change. The exit code
# does not say which; only a pending plan prints an approval token. Classify
# like the GitHub Action's `result` output; buildkite-agent is absent in
# local/bats runs, so guard.
if [ "${exit_code}" -eq 0 ]; then
  result="success"
elif [ "${exit_code}" -eq 2 ]; then
  result="plan-pending"
else
  result="failure"
fi

if command -v buildkite-agent > /dev/null 2>&1; then
  # Without `supersede`, reporting is best effort under set -e, so a transient
  # agent failure after a successful deploy does not replace the deploy's exit
  # status. With it, the next marked build holds on a result this attempt did
  # not record, so a deploy that succeeded fails its step, and a retry deploys
  # the commit again and records its result. The result job is written after
  # the result, so a lost second write reads as no result rather than as an
  # earlier attempt's.
  result_recorded="true"
  if ! buildkite-agent meta-data set "fjall-deploy:result" "${result}"; then
    result_recorded="false"
  elif [ "${record_attempt}" = "true" ] && ! buildkite-agent meta-data set "fjall-deploy:result-job" "${BUILDKITE_JOB_ID}"; then
    result_recorded="false"
  fi
  if [ "${record_attempt}" = "true" ] && [ "${result_recorded}" = "false" ] && [ "${exit_code}" -eq 0 ]; then
    echo "^^^ +++"
    echo "Error: the deploy succeeded, but its result could not be recorded, so the next marked build would hold on it. A retry of this step deploys this commit again and records its result."
    exit_code=1
  fi
  buildkite-agent meta-data set "fjall-deploy:duration" "${duration}" || true
  if [ -n "${token_line}" ]; then
    buildkite-agent meta-data set "fjall-deploy:approval-token" "${token_line#Approval token: }" || true
  fi
  if [ "${result}" = "plan-pending" ] && [ -n "${token_line}" ]; then
    buildkite-agent annotate --style warning \
      "Fjall plan for **${target}** has changes pending approval. Re-run with the \`approval-token\` property set to the \`fjall-deploy:approval-token\` meta-data value to apply." || true
  elif [ "${result}" = "plan-pending" ]; then
    buildkite-agent annotate --style warning \
      "Fjall stopped **${target}** before it completed: the approval gate refused the plan, or the run was cancelled. A cancelled run can stop after applying part of its change; the step log says which." || true
  fi
fi

# After the result is recorded, so the summary can never stand in its way.
report_build_summary || true

exit "${exit_code}"
